<div style="clear:both"><!-- For smooth animation --></div>
<% [:notice, :alert].each do |kind| %>
	<% if flash[kind] %>
		<div id="<%= kind %>" role="<%= kind == :alert ? 'alert' : 'status' %>">
			<div>
				<button type="button" class="dfm_flash_close" data-dfm-dismiss aria-label="Dismiss <%= kind %>">&times;</button>
				<%= sanitize(flash[kind]) %>
			</div>
		</div>
	<% end %>
<% end %>
